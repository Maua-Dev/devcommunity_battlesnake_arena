# Copy to .env and fill in values. Never commit .env.

# Public URL the Arena embeds for the board client (no trailing slash).
# Must be reachable from browsers watching games (not localhost in production).
# EC2 example:  https://arena.dev.devmaua.com
# Local Docker: http://localhost
BASE_URL=https://arena.example.com

# Hostname for Caddy TLS / reverse proxy (usually same host as BASE_URL).
DOMAIN_NAME=arena.example.com

POSTGRES_USER=arena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arena

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://arena.example.com/auth/github/callback
